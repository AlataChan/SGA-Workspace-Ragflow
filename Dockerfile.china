# syntax=docker/dockerfile:1.7

############################################
# Base Image
############################################
FROM registry.cn-hangzhou.aliyuncs.com/myzaizhe/node:20-slim AS base

WORKDIR /app

ENV NEXT_TELEMETRY_DISABLED=1

############################################
# Install dependencies
############################################
FROM base AS deps

COPY package.json package-lock.json* .npmrc* ./

RUN --mount=type=cache,target=/root/.npm \
    npm ci

############################################
# Build stage
############################################
FROM base AS builder

WORKDIR /app

COPY --from=deps /app/node_modules ./node_modules
COPY . .
ENV DATABASE_URL="postgresql://build:build@localhost:5432/build"
ENV NODE_ENV=production

# Prisma generate
RUN npx prisma generate

# Next build
RUN npm run build

############################################
# Production runtime
############################################
FROM registry.cn-hangzhou.aliyuncs.com/myzaizhe/node:20-slim AS runner

WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3000
ENV NEXT_TELEMETRY_DISABLED=1

############################################
# Create user
############################################
RUN groupadd --system --gid 1001 nodejs \
    && useradd --system --uid 1001 --create-home nextjs

############################################
# Copy standalone output
############################################
COPY --from=builder /app/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static
COPY --from=builder --chown=nextjs:nodejs /app/prisma ./prisma

############################################
# Copy entrypoint
############################################
COPY --chown=nextjs:nodejs docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENV NPM_CONFIG_CACHE=/home/nextjs/.npm

USER nextjs

EXPOSE 3000

############################################
# Healthcheck
############################################
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s \
  CMD node -e "fetch('http://localhost:3000/api/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

#ENTRYPOINT ["/entrypoint.sh"]
CMD ["node", "server.js"]